# Variables d'environnement pour JerryTech Flask Backend
# Copier ce fichier vers .env et renseigner les valeurs

# Environment (development ou production)
FLASK_ENV=development

# Clé secrète pour JWT (OBLIGATOIRE en production)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Base de données
# En local: laisser vide pour utiliser SQLite
# En production (Render): postgresql://user:password@host:port/database
DATABASE_URL=

# ========== SÉCURITÉ ==========

# Origines autorisées pour CORS (séparées par des virgules)
# En dev: laisser vide pour autoriser toutes les origines
# En prod: spécifier les domaines autorisés
# Exemple: ALLOWED_ORIGINS=https://jerrytech.com,https://www.jerrytech.com,http://localhost:5501
ALLOWED_ORIGINS=

# API Key optionnelle pour protéger les endpoints sensibles
# Si définie, les requêtes non-authentifiées devront fournir cette clé
# via le header X-API-Key
# Génerer une clé aléatoire: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=

# ========== CLOUDINARY ==========

# Cloudinary (pour l'upload d'images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

